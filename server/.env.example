# Port for Express server
PORT=4000

# MongoDB URI: 
# For local development without MongoDB installed: Leave empty or default (server will use persistent JSON file storage in server/data/quizzy_store.json)
# For cloud deployment (MongoDB Atlas Free M0):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quizzes?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/quizzes

# Secret key for JWT authentication (generate a strong random string in production)
JWT_SECRET=quizzy_secret_jwt_key_replace_in_production

# Client frontend URL for CORS in production (e.g., https://your-quizzy-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# Render Server Keep-Alive Cron (Auto-detects RENDER_EXTERNAL_URL on Render)
# Set your public backend URL to enable self-ping keep-alive (every 12 minutes)
SERVER_URL=https://quizzy-api.onrender.com
ENABLE_KEEP_ALIVE=true
KEEP_ALIVE_INTERVAL_MINUTES=12
